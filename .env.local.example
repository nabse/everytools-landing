# ──────────────────────────────────────────────────────────────────────────────
# Algolia Search
# ──────────────────────────────────────────────────────────────────────────────
#
# NEXT_PUBLIC_ prefix = safe to expose in the browser bundle.
# These two are READ-ONLY keys — they can only search, never write.
#
NEXT_PUBLIC_ALGOLIA_APP_ID=YOUR_APP_ID
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=YOUR_SEARCH_ONLY_API_KEY

# ──────────────────────────────────────────────────────────────────────────────
# Algolia Indexing (server-side / build-time ONLY)
# ──────────────────────────────────────────────────────────────────────────────
#
# NEVER add NEXT_PUBLIC_ here. This key has write access.
# Used only by:  npm run algolia:index  (scripts/algolia-index.ts)
#
# In Vercel: add this as an Environment Variable (not exposed to client).
# In CI/CD: inject via secrets manager (GitHub Actions secrets, etc.).
#
ALGOLIA_APP_ID=YOUR_APP_ID
ALGOLIA_WRITE_KEY=YOUR_WRITE_API_KEY
